# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file (it is git-ignored).

DATABASE_URL=mysql+pymysql://root@localhost/sebms_db
REDIS_URL=redis://localhost:6379/0

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-hex
JWT_SECRET_KEY=replace-with-random-hex
